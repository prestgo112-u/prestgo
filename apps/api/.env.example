# Modèle de configuration de l'API.
#
# À copier en `.env` puis à compléter :
#   cp apps/api/.env.example apps/api/.env
#
# Le fichier `.env` n'est PAS versionné (il contient le mot de passe de la base).

# --- Base de données (obligatoire) ---
# Remplace TON_MOT_DE_PASSE par celui de l'utilisateur "postgres",
# choisi à l'installation de PostgreSQL.
DATABASE_URL="postgresql://postgres:TON_MOT_DE_PASSE@localhost:5432/prestgo?schema=public"

# --- Jeton d'accès (obligatoire) ---
# Valeur de développement. À REMPLACER par une chaîne longue et aléatoire en
# production : c'est elle qui signe les jetons d'accès (courte durée de vie).
ACCESS_TOKEN_SECRET="development-access-token-secret"
#
# Il n'y a PAS de REFRESH_TOKEN_SECRET : depuis le Lot 6, le jeton de
# rafraîchissement n'est plus un JWT signé mais une valeur aléatoire opaque,
# stockée en base (table RefreshSession) sous forme d'empreinte. C'est ce qui
# permet de le révoquer réellement (changement de mot de passe, déconnexion).

# --- Port de l'API ---
API_PORT=3000

# --- Stockage des fichiers déposés (justificatifs, exports CSV) ---
# Chemin relatif au dossier apps/api. Non versionné.
FILE_STORAGE_DIR="storage"

# --- Boîte d'envoi des notifications ---
# Tant qu'aucun fournisseur email/SMS n'est configuré, les messages sont
# écrits ici sous forme de journal, pour pouvoir vérifier ce qui serait parti.
NOTIFICATION_OUTBOX="storage/outbox"

# --- File d'attente (Lot 7, §15.3) ---
# La file est PERSISTANTE dès qu'une REDIS_URL est configurée : ce qui est en
# attente survit alors à un redémarrage. C'est indispensable aux notifications
# push et aux jobs planifiés (§14).
REDIS_URL="redis://localhost:6379"
#
# QUEUE_DRIVER force le choix :
#   bullmq  — file Redis persistante (production)
#   memory  — file en mémoire, perdue au redémarrage (développement sans Redis)
#   inline  — traitement immédiat (tests)
# Sans cette variable : bullmq si REDIS_URL est définie, memory sinon.
# QUEUE_DRIVER=bullmq

# --- Notifications push FCM / APNs (Lot 7, §16.1) ---
# Android et iOS passent tous deux par Firebase Cloud Messaging (Firebase
# relaie vers APNs). Les trois valeurs viennent du fichier JSON de compte de
# service Google. Sans elles, le canal push retombe sur la boîte d'envoi
# fichier — le message est produit et consultable, mais rien n'est poussé.
# FCM_PROJECT_ID="mon-projet-firebase"
# FCM_CLIENT_EMAIL="firebase-adminsdk@mon-projet.iam.gserviceaccount.com"
# FCM_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# --- SMS réel pour l'OTP (Lot 7, §16.2) ---
# L'inscription se fera massivement par téléphone en Côte d'Ivoire : l'OTP doit
# partir par un vrai SMS. Choisir un agrégateur couvrant Orange / MTN / Moov.
# SMS_PROVIDER=termii            # ou : africastalking
#
# Termii :
# TERMII_API_KEY=""
# TERMII_SENDER_ID="PRESTGO"
# TERMII_BASE_URL="https://api.ng.termii.com"   # override rarement nécessaire
#
# Africa's Talking :
# AT_API_KEY=""
# AT_USERNAME=""
# AT_SENDER_ID="PRESTGO"
# AT_BASE_URL="https://api.africastalking.com"  # "sandbox" en test si username=sandbox
#
# Indicatif ajouté aux numéros saisis au format local (« 0700000000 »).
# SMS_DEFAULT_COUNTRY_CODE=225

# --- Proxy inverse (Lot 7, §15.5) ---
# À activer UNIQUEMENT si l'API tourne derrière un proxy (Nginx, load balancer)
# qui réécrit `X-Forwarded-For`. L'en-tête est déclaratif : le lire sans proxy
# permettrait à n'importe qui de falsifier l'adresse IP journalisée en audit.
# TRUST_PROXY=true

# --- Options de développement (facultatif) ---
# Renvoie les codes OTP et les jetons de réinitialisation dans la réponse HTTP,
# pour pouvoir tester ces parcours sans email ni SMS.
# ⚠️ NE JAMAIS activer en production.
# AUTH_EXPOSE_DEV_CODES=true

# Limites d'appels par adresse IP (ou par utilisateur selon la route). Les
# valeurs par défaut du code sont celles voulues en production ; à ne changer
# que si tu sais pourquoi.
# THROTTLE_LIMIT=300              # plafond général, par minute
# THROTTLE_AUTH_LIMIT=10          # /auth/login, par minute
# THROTTLE_SENSITIVE_LIMIT=5      # inscription, envoi de code, par minute
# THROTTLE_MODERATE_LIMIT=30      # renouvellement de jeton, vérif. de code, par minute
# THROTTLE_BOOKING_LIMIT=10       # POST /missions (réservation), par heure et par utilisateur (§14.5)
# THROTTLE_REPORT_LIMIT=20        # POST /reviews/:id/report, par jour et par utilisateur (§14.5)
# THROTTLE_DEVICE_LIMIT=30        # POST /me/devices, par jour et par utilisateur (§14.5)
