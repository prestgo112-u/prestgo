# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Code généré (freezed, json_serializable, riverpod, drift, l10n)
*.g.dart
*.freezed.dart
/lib/l10n/generated/

# Définitions d'environnement locales — `env/{dev,staging,prod}.json` sont versionnés
# et ne contiennent aucun secret ; les surcharges de poste ne le sont pas.
/env/local.json
/env/*.local.json

# Secrets de plateforme (Firebase, signature) — jamais versionnés
/android/app/google-services.json
/ios/Runner/GoogleService-Info.plist
/android/key.properties
*.jks
*.keystore
/lib/firebase_options.dart

# Rapports de test et de couverture
/coverage/
test/**/failures/
